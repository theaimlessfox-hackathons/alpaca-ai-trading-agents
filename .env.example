ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_ACCOUNT_ROLE=sandbox
EXPECTED_ACCOUNT_ID=
COMPETE_ENABLED=false
COMPETE_AFTER=

ALPACA_COMPETITION_API_KEY=
ALPACA_COMPETITION_SECRET_KEY=
ALPACA_COMPETITION_ACCOUNT_ID=

FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=
XAI_FALLBACK=false
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1
USE_ANTHROPIC_FALLBACK=false
ANTHROPIC_API_KEY=

FALLBACK_MLEG=false
ENTRY_TIMEOUT_MINUTES=30

# discover = Alpaca market-data most-actives + movers (optionable only).
# pinned  = UNIVERSE list below. Discover never falls back to SPY/QQQ/IWM.
UNIVERSE_MODE=discover
UNIVERSE_SIZE=15
# UNIVERSE=SPY,QQQ,IWM

# Require repeated cheap-IV/RV readings before closing an existing spread.
# Breakout, stop, halt, and kill-switch exits remain immediate.
REGIME_EXIT_CONFIRMATIONS=2
